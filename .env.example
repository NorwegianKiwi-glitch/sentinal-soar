# Postgres — used by both the app and the db service in docker-compose.yml
POSTGRES_PASSWORD=change-me

# Discord bot — OPTIONAL. Leave DISCORD_BOT_TOKEN / DISCORD_CHANNEL_ID blank to
# run the web console alone (it is the primary UI); set both to also mirror
# alerts and decision buttons into a Discord channel.
# (Developer Portal → Bot → Token; enable it in your test/home server)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=

# AI triage (used to explain each scan's findings) — REQUIRED, exactly one
# provider. Pick with AI_PROVIDER, then fill in only that provider's section
# below. Note: a ChatGPT or Claude.ai *subscription* does NOT include API
# access — API keys are billed separately, from platform.openai.com or
# console.anthropic.com.
AI_PROVIDER=gemini

# gemini (aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# openai (platform.openai.com/api-keys) — OPENAI_MODEL has no default since
# OpenAI's naming changes often; check platform.openai.com/docs/models for
# the current recommended model id.
OPENAI_API_KEY=
OPENAI_MODEL=

# anthropic (console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# openai_compatible — any OpenAI-wire-compatible endpoint: DeepSeek, Qwen,
# Moonshot/Kimi, most other providers, or a self-hosted server (Ollama, LM
# Studio, vLLM, llama.cpp). AI_API_KEY is optional — most self-hosted
# servers don't check it.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Docker / Trivy
DOCKER_SOCKET=unix://var/run/docker.sock
TRIVY_SEVERITY=HIGH,CRITICAL

# Governance policy
SNOOZE_DAYS=7
REFUSE_REVIEW_DAYS=180
SCAN_INTERVAL_HOURS=24

# Web dashboard
WEB_HOST=0.0.0.0
WEB_PORT=8080
FLASK_SECRET_KEY=change-me
# Used only to seed the login on first boot — after that the DB is
# authoritative and the console's Settings page is how you change them.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me

# Cloudflare access traffic — OPTIONAL. Leave blank to skip the Access page's
# polling (dash.cloudflare.com -> My Profile -> API Tokens -> create a token
# scoped to Zone:Analytics:Read on the zone your services sit behind).
# Requires the hostname(s) to be Cloudflare-proxied (e.g. behind a Cloudflare
# Tunnel).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# Comma-separated hostnames to watch on first boot only, e.g.
# shelgen.example.com,photos.example.com — after that the DB is authoritative
# and the Settings page's "Access hostnames" section is how you add/remove them.
CLOUDFLARE_HOSTNAMES=
CLOUDFLARE_POLL_MINUTES=5
